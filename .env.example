# HubSpot private app token, or an existing service key. Needs read scopes only:
#   crm.objects.contacts.read     leads, properties, and the property history behind every progress field
#   crm.objects.owners.read       agent names, including archived owners
#   crm.objects.calls.read        call records for calls total, connected and last conversation
# This service never writes to HubSpot, so it needs no write scope.
HUBSPOT_TOKEN=

# Comma separated topmate_username values this desk covers
CREATORS=creator_one,creator_two

# Sync cadences in minutes
SYNC_MINUTES=10
HISTORY_MINUTES=60
CALLS_MINUTES=60

# Portal, for building record links
HS_PORTAL_ID=
HS_UI_DOMAIN=app-na2.hubspot.com

# Average FIRST payment per creator, JSON. Drives the value score and therefore the queue order.
# Deliberately not committed: these are commercial figures and the repo is public.
# TICKETS={"creator_one":90000,"creator_two":40000}
TICKETS=
DEFAULT_TICKET=50000

# Optional shared secret. When set, /api/refresh requires header x-desk-key
DESK_KEY=

PORT=3000
